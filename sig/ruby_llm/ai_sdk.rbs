module RubyLLM
  # ruby_llm does not currently ship RBS; these declarations let the adapter's
  # public signatures retain their concrete input types.
  class Chunk
  end

  class Message
  end

  module Stream
    interface _StringWriter
      def write: (String) -> untyped
    end

    class AISDK
      VERSION: String
      HEADERS: Hash[String, String]
      FINISH_REASONS: Array[String]

      class Error < StandardError
      end
      class ProtocolError < Error
      end
      class FinishedError < Error
      end
      class JSONCompatibilityError < Error
      end

      def self.headers: () -> Hash[String, String]

      def initialize: (?_StringWriter? io, ?message_id: String?, ?id_generator: ^() -> String) -> void
      def headers: () -> Hash[String, String]
      def frames: () -> Array[String]
      def each: () { (String) -> void } -> self
              | () -> Enumerator[String, self]
      def to_a: () -> Array[String]
      def started?: () -> bool
      def finished?: () -> bool

      def start: (?message_id: String?, ?message_metadata: untyped) -> self
      def start_step: () -> self
      def reset_step: () -> self
      def finish_step: () -> self
      def finish: (?finish_reason: String | Symbol | nil, ?message_metadata: untyped) -> self
      def abort: (?reason: String?) -> self
      def error: (error_text: String) -> self
      def message_metadata: (untyped metadata) -> self

      def write: (RubyLLM::Chunk chunk) -> self
      alias push write
      def <<: (RubyLLM::Chunk chunk) -> self
      def write_message: (RubyLLM::Message message) -> self

      def text_start: (?id: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def text_delta: (id: String, delta: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def text_end: (id: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def reasoning_start: (?id: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def reasoning_delta: (id: String, delta: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def reasoning_end: (id: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self

      def source_url: (source_id: String, url: String, ?title: String?, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def source_document: (source_id: String, media_type: String, title: String, ?filename: String?, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def file: (url: String, media_type: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def reasoning_file: (url: String, media_type: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def data: (name: String, data: untyped, ?id: String?, ?transient: bool?) -> self
      def custom: (kind: String, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self

      def tool_input_start: (tool_call_id: String, tool_name: String, ?provider_executed: bool?, ?provider_metadata: Hash[String | Symbol, untyped]?, ?tool_metadata: Hash[String | Symbol, untyped]?, ?dynamic: bool?, ?title: String?) -> self
      def tool_input_delta: (tool_call_id: String, input_text_delta: String) -> self
      def tool_input_available: (tool_call_id: String, tool_name: String, input: untyped, ?provider_executed: bool?, ?provider_metadata: Hash[String | Symbol, untyped]?, ?tool_metadata: Hash[String | Symbol, untyped]?, ?dynamic: bool?, ?title: String?) -> self
      def tool_input_error: (tool_call_id: String, tool_name: String, input: untyped, error_text: String, ?provider_executed: bool?, ?provider_metadata: Hash[String | Symbol, untyped]?, ?tool_metadata: Hash[String | Symbol, untyped]?, ?dynamic: bool?, ?title: String?) -> self
      def tool_approval_request: (approval_id: String, tool_call_id: String, ?approval_descriptor: untyped, ?reason: String?, ?is_automatic: bool?, ?signature: String?) -> self
      def tool_approval_response: (approval_id: String, approved: bool, ?reason: String?, ?provider_executed: bool?, ?provider_metadata: Hash[String | Symbol, untyped]?) -> self
      def tool_output_available: (tool_call_id: String, output: untyped, ?provider_executed: bool?, ?provider_metadata: Hash[String | Symbol, untyped]?, ?tool_metadata: Hash[String | Symbol, untyped]?, ?dynamic: bool?, ?preliminary: bool?) -> self
      def tool_output_error: (tool_call_id: String, error_text: String, ?provider_executed: bool?, ?provider_metadata: Hash[String | Symbol, untyped]?, ?tool_metadata: Hash[String | Symbol, untyped]?, ?dynamic: bool?) -> self
      def tool_output_denied: (tool_call_id: String) -> self
    end
  end
end
